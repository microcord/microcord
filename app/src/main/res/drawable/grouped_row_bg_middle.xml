<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a modern grouped list: the card's fill, no corners rounded, with a divider under it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBackgroundModifierSelected"/>
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom" android:left="72dp" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="?attr/colorBackgroundModifierAccent"/></shape>
    </item>
</layer-list>
