<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a modern grouped list: the card's fill, bottom corners rounded. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBackgroundModifierSelected"/>
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp"/>
        </shape>
    </item>

</layer-list>
