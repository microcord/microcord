<?xml version="1.0" encoding="utf-8"?>
<!-- Negative insets push the shared edges outside the bounds so only the card's outer border draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBackgroundPrimary"/>
            <stroke android:width="1dp" android:color="?attr/colorPrimaryDivider"/>
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp"/>
        </shape>
    </item>
</layer-list>
