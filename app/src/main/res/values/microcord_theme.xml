<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Custom themes (com.discord.utilities.theme.ThemeRuntime). Both stay empty here: a theme's
        runtime resource table replaces the style's items and the sentinel's value. Only their ids
        matter.
    -->
    <style name="ThemeOverlay.Microcord.Runtime" parent="" />
    <color name="theme_runtime_sentinel">#00000000</color>
    <!--
        Dialogs under a see-through theme (ThemeRuntime.applyDialogOverlay): their window has nothing
        behind it but the dimmed app, so the clear canvas colors take the solid popup color.
    -->
    <style name="ThemeOverlay.Microcord.OpaqueSurfaces" parent="">
        <item name="colorBackgroundPrimary">?attr/colorBackgroundFloating</item>
        <item name="colorBackgroundSecondary">?attr/colorBackgroundFloating</item>
        <item name="colorBackgroundTertiary">?attr/colorBackgroundNestedFloating</item>
    </style>
</resources>
