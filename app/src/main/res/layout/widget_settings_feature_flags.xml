<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView style="@style/UiKit.ViewGroup.NestedScrollView.AppBarScrollingViewBehavior">
        <LinearLayout android:paddingBottom="@dimen/list_bottom_padding" style="@style/UiKit.ViewGroup.LinearLayout">
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_tap_tap" app:cs_text="@string/feature_tap_tap" app:cs_subtext="@string/feature_tap_tap_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_fetch_uncached_users" app:cs_text="@string/feature_fetch_uncached_users" app:cs_subtext="@string/feature_fetch_uncached_users_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_view_profile_images" app:cs_text="@string/feature_view_profile_images" app:cs_subtext="@string/feature_view_profile_images_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_typing_user_avatars" app:cs_text="@string/feature_typing_user_avatars" app:cs_subtext="@string/feature_typing_user_avatars_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_chat_header_status_indicators" app:cs_text="@string/feature_chat_header_status_indicators" app:cs_subtext="@string/feature_chat_header_status_indicators_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_message_limit_counter" app:cs_text="@string/feature_message_limit_counter" app:cs_subtext="@string/feature_message_limit_counter_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:text="@string/feature_chatbox_customizations" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_chatbox_customizations" app:cs_text="@string/feature_chatbox_customizations_enable" app:cs_subtext="@string/feature_chatbox_customizations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_voice_messages" app:cs_text="@string/feature_voice_messages" app:cs_subtext="@string/feature_voice_messages_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_feature_customize_chat_input" android:text="@string/chat_input_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:text="@string/feature_header_customizations" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_header_customizations" app:cs_text="@string/feature_header_customizations_enable" app:cs_subtext="@string/feature_header_customizations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_feature_customize_header" android:text="@string/header_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_feature_collectibles_header" android:text="@string/feature_collectibles" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_avatar_decorations" app:cs_text="@string/feature_avatar_decorations" app:cs_subtext="@string/feature_avatar_decorations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_nameplates" app:cs_text="@string/feature_nameplates" app:cs_subtext="@string/feature_nameplates_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_profile_effects" app:cs_text="@string/feature_profile_effects" app:cs_subtext="@string/feature_profile_effects_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_profile_frames" app:cs_text="@string/feature_profile_frames" app:cs_subtext="@string/feature_profile_frames_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
