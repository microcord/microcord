<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView style="@style/UiKit.ViewGroup.NestedScrollView.AppBarScrollingViewBehavior">
        <LinearLayout android:paddingBottom="@dimen/list_bottom_padding" style="@style/UiKit.ViewGroup.LinearLayout">
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_cloud_backup" app:cs_text="@string/cloud_settings_title" app:cs_subtext="@string/cloud_settings_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_cloud_save" android:visibility="gone" android:text="@string/cloud_settings_save" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_cloud_restore" android:visibility="gone" android:text="@string/cloud_settings_restore" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_cloud_clear" android:visibility="gone" android:text="@string/cloud_settings_clear" android:textColor="?attr/colorError" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_cloud_status" android:visibility="gone" android:text="@string/cloud_settings_working" android:accessibilityLiveRegion="polite" android:padding="16dp" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_tap_tap" app:cs_text="@string/feature_tap_tap" app:cs_subtext="@string/feature_tap_tap_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_fetch_uncached_users" app:cs_text="@string/feature_fetch_uncached_users" app:cs_subtext="@string/feature_fetch_uncached_users_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_view_profile_images" app:cs_text="@string/feature_view_profile_images" app:cs_subtext="@string/feature_view_profile_images_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_typing_user_avatars" app:cs_text="@string/feature_typing_user_avatars" app:cs_subtext="@string/feature_typing_user_avatars_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_chat_header_status_indicators" app:cs_text="@string/feature_chat_header_status_indicators" app:cs_subtext="@string/feature_chat_header_status_indicators_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_more_gif_providers" app:cs_text="@string/feature_more_gif_providers" app:cs_subtext="@string/feature_more_gif_providers_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_gif_url_to_input" app:cs_text="@string/feature_gif_url_to_input" app:cs_subtext="@string/feature_gif_url_to_input_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_quick_message_actions" app:cs_text="@string/feature_quick_message_actions" app:cs_subtext="@string/feature_quick_message_actions_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_message_limit_counter" app:cs_text="@string/feature_message_limit_counter" app:cs_subtext="@string/feature_message_limit_counter_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_nitro_spoof" app:cs_text="@string/feature_nitro_spoof" app:cs_subtext="@string/feature_nitro_spoof_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_silent_typing" app:cs_text="@string/feature_silent_typing" app:cs_subtext="@string/feature_silent_typing_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_smooth_keyboard" app:cs_text="@string/feature_smooth_keyboard" app:cs_subtext="@string/feature_smooth_keyboard_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:text="@string/feature_chatbox_customizations" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_chatbox_customizations" app:cs_text="@string/feature_chatbox_customizations_enable" app:cs_subtext="@string/feature_chatbox_customizations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_voice_messages" app:cs_text="@string/feature_voice_messages" app:cs_subtext="@string/feature_voice_messages_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_feature_customize_chat_input" android:text="@string/chat_input_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:text="@string/feature_header_customizations" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_header_customizations" app:cs_text="@string/feature_header_customizations_enable" app:cs_subtext="@string/feature_header_customizations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_feature_customize_header" android:text="@string/header_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
        <TextView android:id="@+id/settings_feature_customize_dm_list" android:text="@string/dm_list_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_feature_customize_channel_sidebar" android:text="@string/channel_sidebar_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_feature_customize_bottom_tabs" android:text="@string/bottom_tabs_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_feature_customize_profile_popouts" android:text="@string/profile_popout_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:id="@+id/settings_feature_customize_profile_tabs" android:text="@string/profile_tabs_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
            <TextView android:text="@string/feature_message_customizations" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/settings_feature_message_customizations" app:cs_text="@string/feature_message_customizations_enable" app:cs_subtext="@string/feature_message_customizations_description" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <TextView android:id="@+id/settings_feature_customize_messages" android:text="@string/message_customization_title" android:drawableEnd="@drawable/ic_chevron_right_grey_12dp" style="@style/UiKit.Settings.Item.Icon"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
