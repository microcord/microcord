<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_guild_onboarding_option"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="16dp">
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp">
        <TextView
            android:id="@+id/guild_onboarding_option_emoji_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="22sp" />
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/guild_onboarding_option_emoji_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/guild_onboarding_option_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorHeaderPrimary"
            style="@style/UiKit.TextView.Semibold" />
        <TextView
            android:id="@+id/guild_onboarding_option_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorTextMuted"
            style="@style/UiKit.TextView.Medium" />
        <TextView
            android:id="@+id/guild_onboarding_option_member_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_guild_onboarding_member_count"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white"
            android:visibility="gone"
            style="@style/UiKit.TextView.Medium" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/guild_onboarding_option_checked"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle_24dp"
        android:visibility="gone"
        android:tint="?attr/color_brand" />
</LinearLayout>
