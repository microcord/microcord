<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_launcher_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/app_launcher_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:visibility="gone"
        app:placeholderImage="?attr/ic_game_icon_placeholder"
        app:roundAsCircle="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_launcher_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/UiKit.TextView.Semibold" />

            <TextView
                android:id="@+id/app_launcher_row_promoted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/drawable_rect_rounded_bg_tertiary"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/app_launcher_promoted"
                android:textAllCaps="true"
                android:textColor="?attr/colorTextMuted"
                android:textSize="10sp"
                android:visibility="gone"
                style="@style/UiKit.TextView.Bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_launcher_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorTextMuted"
            android:visibility="gone"
            style="@style/UiKit.TextView.Subtext" />
    </LinearLayout>

    <ImageView
        android:id="@+id/app_launcher_row_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right_24dp"
        app:tint="?attr/colorInteractiveNormal" />
</LinearLayout>
