<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_launcher_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawable_app_launcher_group_middle"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.discord.views.VitoImageView
            android:id="@+id/app_launcher_row_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:visibility="gone"
            app:placeholderImage="?attr/ic_game_icon_placeholder"
            app:roundedCornerRadius="8dp"
            app:roundingBorderColor="?attr/colorPrimaryDivider"
            app:roundingBorderWidth="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/app_launcher_row_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    style="@style/UiKit.TextView.Semibold" />

                <TextView
                    android:id="@+id/app_launcher_row_promoted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/drawable_rect_rounded_bg_tertiary"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="@string/app_launcher_promoted"
                    android:textColor="?attr/colorTextMuted"
                    android:textSize="10sp"
                    android:visibility="gone"
                    style="@style/UiKit.TextView.Bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_launcher_row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorTextMuted"
                android:visibility="gone"
                style="@style/UiKit.TextView.Subtext" />
        </LinearLayout>

        <ImageView
            android:id="@+id/app_launcher_row_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right_24dp"
            app:tint="?attr/colorInteractiveNormal" />
    </LinearLayout>

    <View
        android:id="@+id/app_launcher_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="56dp"
        android:background="?attr/colorPrimaryDivider"
        android:importantForAccessibility="no" />
</FrameLayout>
