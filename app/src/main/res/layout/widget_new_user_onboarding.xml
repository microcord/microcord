<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/UiKit.ViewGroup.Page">

    <ViewFlipper
        android:id="@+id/new_user_onboarding_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="48dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">
                <TextView
                    android:id="@+id/new_user_avatar_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:text="@string/skip"
                    android:textColor="?attr/colorInteractiveNormal"
                    style="@style/UiKit.TextView.Semibold" />
                <com.discord.views.ScreenTitleView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    app:stv_title="@string/avatar_in_onboarding_modal_title"
                    app:stv_subtitle="@string/avatar_in_onboarding_modal_subtitle" />
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/new_user_avatar_preview"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@string/avatar_in_onboarding_add_picture_cta"
                    app:roundAsCircle="true" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/new_user_avatar_upload"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/avatar_in_onboarding_add_picture_cta"
                    style="@style/UiKit.Material.Button.Secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/avatar_in_onboarding_default_select_subtitle"
                    android:textColor="?attr/colorHeaderSecondary"
                    style="@style/UiKit.TextView.Medium" />
                <LinearLayout
                    android:id="@+id/new_user_default_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal" />
                <com.discord.views.LoadingButton
                    android:id="@+id/new_user_avatar_next"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp"
                    app:lb_text="@string/next"
                    style="@style/UiKit.Material.Button" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">
                <ImageView
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="@string/nux_notification_permission_alert_title"
                    android:padding="32dp"
                    android:src="@drawable/ic_notification_24dp"
                    android:tint="?attr/colorInteractiveActive" />
                <com.discord.views.ScreenTitleView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:stv_title="@string/nux_notification_permission_alert_title"
                    app:stv_subtitle="@string/nux_notification_permission_prompt_subtitle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="@string/nux_notification_permission_prompt_text"
                    android:textColor="?attr/colorTextMuted"
                    style="@style/UiKit.TextView.Medium" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/new_user_notifications_allow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/allow"
                    style="@style/UiKit.Material.Button" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/new_user_notifications_skip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/not_now"
                    style="@style/UiKit.Material.Button.Secondary" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@string/discoverability_landing_title"
                    android:src="@drawable/img_contact_sync_landing_header" />
                <com.discord.views.ScreenTitleView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:stv_title="@string/discoverability_landing_title"
                    app:stv_subtitle="@string/discoverability_landing_subtitle" />
                <com.discord.views.CheckedSetting
                    android:id="@+id/new_user_discoverability_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cs_text="@string/discoverability_landing_toggle_label"
                    app:cs_text_fontpath="?attr/font_primary_semibold"
                    style="@style/UiKit.CheckedSetting.Themed" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/discoverability_landing_info"
                    android:textColor="?attr/colorTextMuted"
                    style="@style/UiKit.TextView.Medium" />
                <com.discord.views.LoadingButton
                    android:id="@+id/new_user_discoverability_next"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:lb_text="@string/next"
                    style="@style/UiKit.Material.Button" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">
                <com.discord.views.ScreenTitleView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:stv_title="@string/contact_sync_enter_name_title"
                    app:stv_subtitle="@string/contact_sync_enter_name_subtitle" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/new_user_discoverability_name_wrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contact_sync_enter_name_input_header"
                    style="@style/UiKit.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName"
                        style="@style/UiKit.TextInputLayout.EditText" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.discord.views.LoadingButton
                    android:id="@+id/new_user_discoverability_name_next"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    app:lb_text="@string/next"
                    style="@style/UiKit.Material.Button" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>

    <com.discord.utilities.dimmer.DimmerView style="@style/UiKit.DimmerView" />
</FrameLayout>
