<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_launcher_activity_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorBackgroundPrimary"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorPrimaryDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.discord.views.VitoImageView
                android:id="@+id/app_launcher_activity_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="?attr/ic_game_icon_placeholder"
                app:placeholderImageScaleType="centerCrop"
                app:viewAspectRatio="1.7777778" />

            <TextView
                android:id="@+id/app_launcher_activity_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/drawable_app_launcher_badge_new"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="4dp"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone"
                style="@style/UiKit.TextView.Bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/app_launcher_activity_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            style="@style/UiKit.TextView.Semibold" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>
