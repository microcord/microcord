<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@null"
    app:cardBackgroundColor="?attr/colorBackgroundSecondary"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <com.discord.views.VitoImageView
            android:id="@+id/soundboard_sound_emoji"
            android:layout_width="36dp"
            android:layout_height="36dp" />

        <TextView
            android:id="@+id/soundboard_sound_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            style="@style/UiKit.TextView.Semibold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/soundboard_sound_lock"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_channel_lock_16dp"
        android:visibility="gone"
        app:tint="?attr/colorTextMuted" />
</com.google.android.material.card.MaterialCardView>
