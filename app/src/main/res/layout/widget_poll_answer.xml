<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/poll_answer_progress"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:visibility="gone"
        app:indicatorColor="?attr/color_brand"
        app:trackColor="@android:color/transparent"
        app:trackThickness="58dp" />

    <View
        android:id="@+id/poll_answer_winner"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="?attr/colorButtonPositiveBackground"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.discord.views.VitoImageView
            android:id="@+id/poll_answer_emoji"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/poll_answer_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorHeaderPrimary"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/poll_answer_votes"
            app:layout_constraintEnd_toStartOf="@id/poll_answer_radio"
            app:layout_constraintStart_toEndOf="@id/poll_answer_emoji"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/poll_answer_votes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/poll_answer_radio"
            app:layout_constraintStart_toEndOf="@id/poll_answer_emoji"
            app:layout_constraintTop_toBottomOf="@id/poll_answer_text"
            style="@style/UiKit.TextView.Subtext" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/poll_answer_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/poll_answer_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/poll_answer_me_voted"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/poll_you_voted"
            android:src="@drawable/ic_check_circle_24dp"
            app:tint="?attr/color_brand"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
