<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout android:orientation="vertical" app:layout_behavior="@string/appbar_scrolling_view_behavior" style="@style/UiKit.ViewGroup.LinearLayout">
        <com.google.android.material.tabs.TabLayout android:id="@+id/header_customization_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabGravity="fill" app:tabMode="fixed" app:tabTextAppearance="@style/App.TabLayout.Text" app:tabTextColor="?attr/colorTextMuted" app:tabSelectedTextColor="?attr/colorHeaderPrimary" app:tabIndicatorColor="?attr/colorHeaderPrimary"/>
        <TextView android:padding="16dp" android:text="@string/header_customization_description" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView"/>
        <LinearLayout android:id="@+id/header_customization_preview" android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="8dp" android:paddingBottom="16dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
            <FrameLayout android:clipChildren="false" android:clipToPadding="false" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="6dp">
                <ImageView android:id="@+id/header_customization_channel_icon" android:layout_gravity="center_vertical" android:visibility="gone" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_channel_text_grey_a60_24dp"/>
                <com.facebook.drawee.view.SimpleDraweeView android:id="@+id/header_customization_avatar" android:layout_gravity="center_vertical" android:layout_width="24dp" android:layout_height="24dp"/>
                <com.discord.views.StatusView android:layout_gravity="bottom|end" android:id="@+id/header_customization_status" android:visibility="gone" android:layout_width="12dp" android:layout_height="12dp" app:sv_background_color="?attr/colorBackgroundPrimary" app:sv_border_width="1.5dp" app:sv_corner_radius="1.5dp" app:sv_mobile_width="9dp" app:sv_mobile_height="14dp"/>
            </FrameLayout>
            <TextView android:id="@+id/header_customization_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/header_customization_preview_title" android:textColor="?attr/colorTextNormal" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" style="@style/UiKit.TextView"/>
            <LinearLayout android:id="@+id/header_customization_actions" android:gravity="center_vertical|end" android:minWidth="160dp" android:layout_width="wrap_content" android:layout_height="56dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:orientation="vertical" style="@style/UiKit.ViewGroup.LinearLayout">
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_show_header" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_show_avatar" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_show_title" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_show_status" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_voice" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_video" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_search" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_members" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/header_customization_pins" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
