<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorBackgroundPrimary">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/status_red_500" android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/safety_hub_standalone_page_nagbar" android:textSize="@dimen/uikit_textsize_small" android:textColor="@color/white" style="@style/UiKit.TextView"/>
            <TextView android:id="@+id/suspended_user_learn_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/safety_hub_standalone_page_nagbar_cta" android:textSize="@dimen/uikit_textsize_small" android:textColor="@color/white" style="@style/UiKit.TextView.Semibold"/>
        </LinearLayout>
        <ImageButton android:id="@+id/suspended_user_close" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close" android:src="@drawable/ic_close_white_24dp" android:scaleType="centerInside"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/suspended_user_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
