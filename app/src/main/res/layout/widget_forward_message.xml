<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar android:id="@+id/action_bar_toolbar" app:navigationIcon="?attr/ic_action_bar_close" app:title="@string/message_action_forward_to" style="@style/AppTheme.Toolbar.Transparent"/>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.textfield.TextInputLayout android:id="@+id/forward_search" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" style="@style/UiKit.TextInputLayout.Search">
        <com.google.android.material.textfield.TextInputEditText android:hint="@string/search" style="@style/UiKit.TextInputLayout.EditText.SingleLine.Search"/>
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/forward_destinations" android:clipToPadding="false" android:paddingBottom="8dp" style="@style/UiKit.ViewGroup.RecyclerView"/>
        <TextView android:layout_gravity="center" android:gravity="center" android:id="@+id/forward_no_results" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="32dp" android:text="@string/search_no_results" style="@style/UiKit.TextView.NoResults"/>
    </FrameLayout>

    <LinearLayout android:id="@+id/forward_footer" android:orientation="vertical" android:background="?attr/colorBackgroundSecondary" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:elevation="@dimen/app_elevation" android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/forward_preview" android:layout_width="match_parent" android:layout_height="wrap_content">
            <include layout="@layout/view_forward_preview"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View android:id="@+id/forward_footer_divider" android:background="?attr/colorBackgroundModifierAccent" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

        <LinearLayout android:orientation="horizontal" android:gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/forward_comment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="0dp" app:startIconDrawable="@null" style="@style/UiKit.TextInputLayout.Search">
                <com.google.android.material.textfield.TextInputEditText android:hint="@string/forward_message_optional_comment" style="@style/UiKit.TextInputLayout.EditText.MultiLine"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/forward_send" android:layout_height="wrap_content" android:text="@string/send" android:layout_marginStart="12dp" style="@style/UiKit.Material.Button.Fit"/>
        </LinearLayout>

        <TextView android:textColor="?attr/colorTextWarning" android:id="@+id/forward_warning" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/UiKit.TextView.Subtext"/>
    </LinearLayout>
</LinearLayout>
