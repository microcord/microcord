<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.CoordinatorLayout.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView style="@style/UiKit.ViewGroup.NestedScrollView.AppBarScrollingViewBehavior">
        <LinearLayout android:paddingBottom="24dp" style="@style/UiKit.ViewGroup.LinearLayout">
            <TextView android:id="@+id/channel_integrations_description" android:paddingTop="16dp" style="@style/UiKit.Settings.Item.SubText"/>
            <LinearLayout android:id="@+id/channel_integrations_webhooks" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_diag_link_24dp" app:tint="?attr/colorInteractiveNormal" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_marginStart="24dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/UiKit.ViewGroup.LinearLayout">
                    <TextView android:text="@string/webhooks" style="@style/UiKit.TextView"/>
                    <TextView android:text="@string/integrations_webhooks_sub_label" android:textColor="?attr/primary_300" android:textSize="@dimen/uikit_textsize_medium" style="@style/UiKit.TextView"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_carrot" android:importantForAccessibility="no"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/channel_integrations_channels_followed" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_channel_announcements" app:tint="?attr/colorInteractiveNormal" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_marginStart="24dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/UiKit.ViewGroup.LinearLayout">
                    <TextView android:text="@string/integrations_channel_following" style="@style/UiKit.TextView"/>
                    <TextView android:text="@string/integrations_channel_following_sub_label" android:textColor="?attr/primary_300" android:textSize="@dimen/uikit_textsize_medium" style="@style/UiKit.TextView"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_carrot" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
