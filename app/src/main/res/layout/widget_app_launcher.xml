<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="480dp"
    android:background="?attr/colorBackgroundSecondary">

    <View
        android:id="@+id/app_launcher_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/drawable_app_launcher_handle"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/app_launcher_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="?attr/ic_action_bar_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_handle"
        app:tint="?attr/colorInteractiveNormal" />

    <TextView
        android:id="@+id/app_launcher_title"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/apps"
        app:layout_constraintEnd_toStartOf="@id/app_launcher_close"
        app:layout_constraintStart_toEndOf="@id/app_launcher_back"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_handle"
        style="@style/UiKit.TextView.H2" />

    <ImageView
        android:id="@+id/app_launcher_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="12dp"
        android:src="@drawable/ic_close_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_handle"
        app:tint="?attr/colorInteractiveNormal" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/app_launcher_search_wrap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_title"
        app:boxBackgroundColor="?attr/colorInputBackground"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusTopStart="20dp"
        app:endIconMode="clear_text"
        app:startIconTint="?attr/colorInteractiveNormal"
        style="@style/UiKit.TextInputLayout.Search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/app_launcher_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/app_launcher_search_apps"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="100"
            style="@style/UiKit.TextInputLayout.EditText.SingleLine.Search" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:id="@+id/app_launcher_search_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:alpha="0"
        android:background="?attr/colorBackgroundModifierAccent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_search_wrap" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_launcher_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/app_launcher_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_launcher_search_divider" />

    <com.discord.views.LoadingButton
        android:id="@+id/app_launcher_action"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lb_text="@string/app_launcher_use_command" />
</androidx.constraintlayout.widget.ConstraintLayout>
