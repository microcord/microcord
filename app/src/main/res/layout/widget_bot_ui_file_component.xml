<?xml version="1.0" encoding="utf-8"?>
<com.discord.widgets.botuikit.views.v2.FileComponentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_component_v2_file"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_file_24dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/UiKit.TextView.Semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorTextLink" />

        <TextView
            android:id="@+id/size"
            style="@style/UiKit.TextView.Subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/download"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/download"
        android:src="@drawable/ic_file_download_grey_24dp" />
</com.discord.widgets.botuikit.views.v2.FileComponentView>
