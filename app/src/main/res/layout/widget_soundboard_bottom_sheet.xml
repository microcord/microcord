<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackgroundPrimary"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    style="@style/UiKit.ViewGroup.LinearLayout">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/guild_settings_soundboard"
        style="@style/UiKit.TextView.H1.Bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/drawable_bg_corners_4dp"
        android:backgroundTint="?attr/colorBackgroundTertiary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/soundboard_search_input"
            android:layout_width="match_parent"
            android:background="@null"
            android:hint="@string/search"
            style="@style/UiKit.SearchInput" />

        <ImageView
            android:id="@+id/soundboard_search_clear"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_close_24dp"
            app:tint="?attr/colorTextMuted"
            style="@style/UiKit.SearchInputClear" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/soundboard_sounds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/soundboard_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_results_found"
        android:visibility="gone"
        style="@style/UiKit.TextView" />
</LinearLayout>
