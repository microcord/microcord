    <androidx.recyclerview.widget.RecyclerView android:id="@+id/manage_reactions_emojis_recycler" android:paddingLeft="4dp" android:paddingRight="4dp" android:clipToPadding="false" android:layout_height="50dp" android:nestedScrollingEnabled="false" style="@style/UiKit.ViewGroup.RecyclerView.Horizontal"/>
