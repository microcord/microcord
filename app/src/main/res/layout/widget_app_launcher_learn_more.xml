<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawable_app_launcher_learn_more_bg"
    android:gravity="center_horizontal"
    android:layout_marginTop="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_launcher_learn_more_title"
        style="@style/UiKit.TextView.H1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_launcher_learn_more_body"
        android:textSize="12sp"
        style="@style/UiKit.TextView" />

    <TextView
        android:id="@+id/app_launcher_learn_more_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/drawable_app_launcher_learn_more_button"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="@string/app_launcher_learn_more_action"
        style="@style/UiKit.TextView.Semibold" />
</LinearLayout>
