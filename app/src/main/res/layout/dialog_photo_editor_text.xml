<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/photo_editor_bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/photo_editor_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/photo_editor_add_text"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/UiKit.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/photo_editor_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/photo_editor_text_input_background"
            android:hint="Enter your text…"
            android:textColorHint="#80848e"
            android:maxLines="4"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="28sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <AutoCompleteTextView
        android:id="@+id/photo_editor_text_font"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/photo_editor_text_input_background"
        android:hint="Search font (e.g. sans-serif)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text="sans-serif"
        android:textColor="@color/white"
        android:textColorHint="#80848e" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/photo_editor_text_bold" style="@style/PhotoEditorTextToggle" android:text="B" android:textStyle="bold" />
        <TextView android:id="@+id/photo_editor_text_italic" style="@style/PhotoEditorTextToggle" android:text="I" android:textStyle="italic" />
        <TextView android:id="@+id/photo_editor_text_underline" style="@style/PhotoEditorTextToggle" android:text="U" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/photo_editor_text_size_label" android:layout_width="65dp" android:layout_height="wrap_content" android:textColor="#b5bac1" android:textSize="14sp" />
        <com.google.android.material.slider.Slider android:id="@+id/photo_editor_text_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="10" android:valueTo="120" android:stepSize="1" app:thumbColor="#5865f2" app:trackColorActive="#5865f2" app:trackColorInactive="#4e5058" xmlns:app="http://schemas.android.com/apk/res-auto" />
        <View android:id="@+id/photo_editor_text_color" style="@style/PhotoEditorColorSwatch" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/photo_editor_text_delete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/delete"
            android:textColor="#da373c"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/photo_editor_text_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/cancel"
            android:textColor="#dbdee1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_editor_text_add"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/photo_editor_primary_button"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/add"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
