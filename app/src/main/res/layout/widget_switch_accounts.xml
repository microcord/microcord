            <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_add_24dp" app:tint="?attr/colorTextLink"/>
            <TextView android:id="@+id/switch_accounts_add_label" android:layout_marginStart="16dp" android:textColor="?attr/colorTextLink" android:text="@string/switch_accounts_add_an_account_button" style="@style/UiKit.TextView.Large"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
