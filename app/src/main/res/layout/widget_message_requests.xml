<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackgroundSecondary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/message_requests_toolbar"
        style="@style/AppTheme.AppBarLayout.Flat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.discord.views.segmentedcontrol.SegmentedControlContainer
        android:id="@+id/message_requests_tabs"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/drawable_segmented_control_container_bg"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message_requests_toolbar">
        <com.discord.views.segmentedcontrol.CardSegment
            android:id="@+id/message_requests_requests_tab"
            app:segment_text="@string/message_requests_requests_tab"
            style="@style/SegmentedControlTabCard" />
        <com.discord.views.segmentedcontrol.CardSegment
            android:id="@+id/message_requests_spam_tab"
            app:segment_text="@string/message_requests_spam_tab"
            style="@style/SegmentedControlTabCard" />
    </com.discord.views.segmentedcontrol.SegmentedControlContainer>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_requests_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:background="?attr/colorBackgroundPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message_requests_tabs" />

    <LinearLayout
        android:id="@+id/message_requests_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="?attr/colorBackgroundPrimary"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message_requests_tabs">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="?attr/theme_friends_no_request" />
        <TextView
            android:id="@+id/message_requests_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="?attr/colorHeaderSecondary"
            style="@style/UiKit.TextView.Subtext" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
