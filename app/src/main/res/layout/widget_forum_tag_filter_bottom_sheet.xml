<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/primary_630"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tag_filter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="@string/forum_tag_filter_header"
            android:textColor="?attr/colorHeaderPrimary"
            style="@style/UiKit.TextView.H2" />

        <TextView
            android:id="@+id/tag_filter_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:text="@string/clear"
            android:textColor="?attr/colorTextLink"
            style="@style/UiKit.TextView" />

        <TextView
            android:id="@+id/tag_filter_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tag_filter_title"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorHeaderSecondary"
            style="@style/UiKit.TextView.Subtext" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/tag_filter_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
