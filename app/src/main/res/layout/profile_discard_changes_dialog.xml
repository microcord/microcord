<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/UiKit.ViewGroup.Page.LinearLayout">

    <TextView
        android:id="@+id/view_dialog_confirmation_header"
        style="@style/UiKit.TextView.H1.Bold"
        android:layout_width="match_parent"
        android:padding="16dp"
        android:text="@string/discard_changes" />

    <View style="@style/UiKit.Divider" />

    <TextView
        android:id="@+id/view_dialog_confirmation_text"
        style="@style/UiKit.Settings.Item.SubText"
        android:text="@string/discard_changes_description" />

    <View style="@style/UiKit.Settings.Divider" />
    <View style="@style/UiKit.Divider" />

    <LinearLayout style="@style/UiKit.Dialog.ButtonContainer">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_dialog_confirmation_cancel"
            style="@style/UiKit.Material.Button.Transparent.Fit"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_dialog_confirmation_confirm"
            style="@style/UiKit.Material.Button.Fit"
            android:text="@string/okay" />
    </LinearLayout>
</LinearLayout>
