<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/UiKit.ViewGroup.Page">

    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout style="@style/AppTheme.AppBarScrollingViewBehavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/manage_reactions_emojis_recycler"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:background="?attr/primary_630"
            android:clipToPadding="false"
            android:elevation="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            style="@style/UiKit.ViewGroup.RecyclerView.Horizontal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/manage_reactions_results_recycler"
            android:layout_below="@id/manage_reactions_emojis_recycler"
            android:layout_alignParentBottom="true"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            style="@style/UiKit.ViewGroup.RecyclerView" />

        <LinearLayout
            android:id="@+id/poll_details_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/manage_reactions_emojis_recycler"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="?attr/theme_friends_no_friends" />
            <TextView
                android:id="@+id/poll_details_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                style="@style/UiKit.TextView.H2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/poll_details_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/retry"
                android:visibility="gone"
                style="@style/UiKit.Material.Button.Fit" />
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
