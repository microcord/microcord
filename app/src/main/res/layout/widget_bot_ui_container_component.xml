<?xml version="1.0" encoding="utf-8"?>
<com.discord.widgets.botuikit.views.v2.ContainerComponentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/component_v2_container_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/accent"
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/components"
            android:divider="@drawable/bot_ui_component_v2_gap_drawable"
            android:showDividers="middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_spoiler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:background="?attr/primary_700" />

        <TextView
            style="@style/UiKit.TextView.Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_component_v2_badge"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/spoiler"
            android:textAllCaps="true"
            android:textColor="@color/white" />
    </FrameLayout>
</com.discord.widgets.botuikit.views.v2.ContainerComponentView>
