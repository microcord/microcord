<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView style="@style/UiKit.ViewGroup.NestedScrollView.AppBarScrollingViewBehavior">
        <LinearLayout android:orientation="vertical" android:paddingBottom="32dp" style="@style/UiKit.ViewGroup.LinearLayout">
            <TextView android:text="Surfaces" style="@style/UiKit.Settings.Item.Header"/>
            <LinearLayout android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <TextView android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:background="?attr/colorBackgroundPrimary" android:text="Primary" style="@style/UiKit.TextView"/>
                <TextView android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:background="?attr/colorBackgroundSecondary" android:text="Secondary" style="@style/UiKit.TextView"/>
                <TextView android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:background="?attr/colorBackgroundTertiary" android:text="Tertiary" style="@style/UiKit.TextView"/>
            </LinearLayout>

            <TextView android:text="Header and Navigation" style="@style/UiKit.Settings.Item.Header"/>
            <androidx.appcompat.widget.Toolbar android:layout_width="match_parent" android:layout_height="56dp" android:background="?attr/colorBackgroundPrimary" app:contentInsetStart="16dp" app:contentInsetEnd="16dp">
                <com.discord.views.ToolbarTitleLayout android:id="@+id/theme_gallery_header_preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
            </androidx.appcompat.widget.Toolbar>

            <TextView android:text="Typography" style="@style/UiKit.Settings.Item.Header"/>
            <TextView android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="Display Heading" style="@style/UiKit.TextView.H1"/>
            <TextView android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="Normal body text for theme comparison" style="@style/UiKit.TextView.Large"/>
            <TextView android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="Muted supporting text" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView.Subtext"/>
            <TextView android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="Interactive link text" style="@style/UiKit.TextView.Link"/>
            <TextView android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="Error and destructive text" android:textColor="?attr/colorError" style="@style/UiKit.TextView.Semibold"/>

            <TextView android:text="Buttons" style="@style/UiKit.Settings.Item.Header"/>
            <LinearLayout android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_weight="1" android:text="Primary" style="@style/UiKit.Material.Button.Fit"/>
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_weight="1" android:text="Secondary" style="@style/UiKit.Material.Button.Secondary.Fit"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_weight="1" android:text="Outline" style="@style/UiKit.Material.Button.Outline"/>
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_weight="1" android:text="@string/delete" style="@style/UiKit.Material.Button.Red.Fit"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.discord.views.LoadingButton android:id="@+id/theme_gallery_loading_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" app:lb_text="Loading" app:lb_progress_color="@color/white" app:lb_background_color="?attr/color_brand"/>
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_weight="1" android:enabled="false" android:text="Disabled" style="@style/UiKit.Material.Button.Secondary.Fit"/>
            </LinearLayout>

            <TextView android:text="Inputs" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.SearchInputView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" app:siv_hint="@string/search" app:siv_search_content_description="@string/search"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_marginEnd="16dp" android:hint="Text Input" style="@style/UiKit.TextInputLayout.Primary">
                <com.google.android.material.textfield.TextInputEditText android:focusable="false" android:text="Example value" style="@style/UiKit.TextInputLayout.EditText.SingleLine"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:text="Settings and Selection" style="@style/UiKit.Settings.Item.Header"/>
            <com.discord.views.CheckedSetting android:id="@+id/theme_gallery_switch" app:cs_text="Checked Setting Switch" app:cs_subtext="Supporting text and active control color" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/theme_gallery_checkbox" app:cs_text="Checkbox" app:cs_view_type="check" style="@style/UiKit.CheckedSetting.Themed"/>
            <com.discord.views.CheckedSetting android:id="@+id/theme_gallery_radio" app:cs_text="Radio" app:cs_view_type="radio" style="@style/UiKit.CheckedSetting.Themed"/>

            <TextView android:text="Identity and Status" style="@style/UiKit.Settings.Item.Header"/>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.facebook.drawee.view.SimpleDraweeView android:id="@+id/theme_gallery_avatar" android:layout_width="48dp" android:layout_height="48dp" app:roundAsCircle="true"/>
                <com.discord.views.UsernameView android:id="@+id/theme_gallery_username" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="8dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.discord.views.StatusView android:id="@+id/theme_gallery_status_online" android:layout_width="20dp" android:layout_height="20dp" app:sv_border_width="1dp" app:sv_background_color="?attr/colorBackgroundPrimary"/>
                <com.discord.views.StatusView android:id="@+id/theme_gallery_status_idle" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" app:sv_border_width="1dp" app:sv_background_color="?attr/colorBackgroundPrimary"/>
                <com.discord.views.StatusView android:id="@+id/theme_gallery_status_dnd" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" app:sv_border_width="1dp" app:sv_background_color="?attr/colorBackgroundPrimary"/>
                <com.discord.views.StatusView android:id="@+id/theme_gallery_status_offline" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" app:sv_border_width="1dp" app:sv_background_color="?attr/colorBackgroundPrimary"/>
                <com.discord.views.StatusView android:id="@+id/theme_gallery_status_mobile" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" app:sv_border_width="1dp" app:sv_background_color="?attr/colorBackgroundPrimary"/>
            </LinearLayout>

            <TextView android:text="Chat and Progress" style="@style/UiKit.Settings.Item.Header"/>
            <include android:id="@+id/theme_gallery_message" layout="@layout/widget_chat_list_adapter_item_text"/>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <com.discord.views.ReactionView android:id="@+id/theme_gallery_reaction" android:layout_width="wrap_content" android:layout_height="26dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:background="?attr/theme_chat_reaction_background" android:gravity="center"/>
                <com.discord.views.typing.TypingDots android:id="@+id/theme_gallery_typing" android:layout_width="28dp" android:layout_height="20dp" android:layout_marginStart="16dp"/>
                <ProgressBar android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp"/>
            </LinearLayout>

            <TextView android:text="Chips" style="@style/UiKit.Settings.Item.Header"/>
            <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:checkable="true" android:text="Selected"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="Unselected"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:enabled="false" android:text="Disabled"/>
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
