<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/colorBackgroundSecondary" app:cardCornerRadius="8dp" app:cardElevation="0dp">
    <LinearLayout android:id="@+id/channel_content_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <FrameLayout android:id="@+id/channel_content_preview_container" android:layout_width="match_parent" android:layout_height="180dp">
            <com.facebook.drawee.view.SimpleDraweeView android:id="@+id/channel_content_preview" android:layout_width="match_parent" android:layout_height="match_parent" app:actualImageScaleType="centerCrop" app:roundedCornerRadius="6dp" />
            <com.facebook.drawee.view.SimpleDraweeView android:id="@+id/channel_content_grid_avatar" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|start" android:layout_margin="6dp" android:background="@drawable/drawable_circle_black" android:padding="2dp" app:roundAsCircle="true" />
            <ImageView android:id="@+id/channel_content_play" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/drawable_circle_black" android:padding="8dp" android:src="@drawable/ic_play_arrow_24dp" android:visibility="gone" app:tint="@color/white" />
        </FrameLayout>
        <LinearLayout android:id="@+id/channel_content_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/channel_content_file_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:padding="6dp" android:src="@drawable/ic_file_24dp" android:visibility="gone" app:tint="?attr/colorInteractiveNormal" />
            <com.facebook.drawee.view.SimpleDraweeView android:id="@+id/channel_content_avatar" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="8dp" app:roundAsCircle="true" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/channel_content_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="?attr/colorTextNormal" android:textStyle="bold" style="@style/UiKit.TextView" />
                <TextView android:id="@+id/channel_content_metadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="2" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView.Subtext" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
