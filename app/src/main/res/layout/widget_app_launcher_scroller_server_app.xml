<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:background="@drawable/drawable_app_launcher_scroller_tile"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.discord.views.VitoImageView
        android:id="@+id/app_launcher_scroller_server_app_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        app:placeholderImage="?attr/ic_game_icon_placeholder"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/colorPrimaryDivider"
        app:roundingBorderWidth="1dp" />

    <TextView
        android:id="@+id/app_launcher_scroller_server_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="180dp"
        style="@style/UiKit.TextView.Semibold" />
</LinearLayout>
