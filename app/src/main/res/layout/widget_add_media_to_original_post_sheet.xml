<?xml version="1.0" encoding="utf-8"?>
<!--
  RN's AddMediaToOriginalForumPostActionSheet: the post as it will look, then the question. The
  padding sits one level in because the sheet sets the root's padding to the window insets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/drawable_add_media_post_card"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/add_media_post_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorHeaderPrimary"
                    android:textSize="16sp"
                    style="@style/UiKit.TextView.Semibold" />

                <TextView
                    android:id="@+id/add_media_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="?attr/colorTextMuted"
                    android:textSize="14sp"
                    style="@style/UiKit.TextView" />
            </LinearLayout>

            <TextView
                android:id="@+id/add_media_post_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorHeaderPrimary"
                android:textSize="20sp"
                style="@style/UiKit.TextView.Bold" />

            <TextView
                android:id="@+id/add_media_post_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorHeaderSecondary"
                android:textSize="16sp"
                style="@style/UiKit.TextView" />

            <TextView
                android:id="@+id/add_media_post_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="?attr/colorHeaderSecondary"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_chat_message_16dp"
                app:drawableTint="?attr/colorHeaderSecondary"
                style="@style/UiKit.TextView.Semibold" />
        </LinearLayout>

        <com.discord.views.VitoImageView
            android:id="@+id/add_media_post_thumbnail"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/forum_add_media_to_original_post_title"
        android:textColor="?attr/colorHeaderPrimary"
        android:textSize="24sp"
        style="@style/UiKit.TextView.Bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/forum_add_media_to_original_post_description"
        android:textColor="?attr/colorHeaderSecondary"
        android:textSize="16sp"
        style="@style/UiKit.TextView" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_media_to_post_add"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/forum_add_media_to_original_post_add"
            app:cornerRadius="8dp"
            style="@style/UiKit.Material.Button" />

        <ProgressBar
            android:id="@+id/add_media_to_post_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_media_to_post_dont_add"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/forum_add_media_to_original_post_dont_add"
        app:cornerRadius="8dp"
        style="@style/UiKit.Material.Button.Secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_media_to_post_cancel"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel"
        app:cornerRadius="8dp"
        style="@style/UiKit.Material.Button.Secondary" />
</LinearLayout>
</FrameLayout>
