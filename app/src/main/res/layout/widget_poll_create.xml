<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/UiKit.ViewGroup.Page">

    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:fillViewport="true"
        app:layout_behavior="@string/action_bar_scrolling_view_behavior"
        style="@style/UiKit.ViewGroup.ScrollView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/poll_question"
                style="@style/UiKit.Stage.SectionHeader" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/poll_question_wrap"
                android:hint="@string/poll_question_hint"
                app:counterEnabled="true"
                app:counterMaxLength="300"
                style="@style/UiKit.TextInputLayout.Primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:maxLength="300"
                    android:maxLines="4"
                    android:inputType="textCapSentences|textMultiLine"
                    style="@style/UiKit.TextInputLayout.EditText.MultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/poll_answers"
                style="@style/UiKit.Stage.SectionHeader" />

            <LinearLayout
                android:id="@+id/poll_answers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/poll_add_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/poll_add_answer"
                app:icon="@drawable/ic_add_24dp"
                style="@style/UiKit.Material.Button.Secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/poll_options"
                style="@style/UiKit.Stage.SectionHeader" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/poll_duration"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/poll_duration">
                <TextView
                    android:id="@+id/poll_duration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/poll_duration"
                    app:layout_constraintBottom_toTopOf="@id/poll_duration_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/UiKit.TextView.Medium" />
                <TextView
                    android:id="@+id/poll_duration_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/poll_duration_chevron"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/poll_duration_label"
                    style="@style/UiKit.TextView.Subtext" />
                <ImageView
                    android:id="@+id/poll_duration_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="?attr/ic_navigate_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorInteractiveNormal" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/poll_multiselect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:text="@string/poll_allow_multiple_answers"
                android:textColor="?attr/colorHeaderPrimary"
                android:textSize="16sp"
                app:thumbTint="?attr/colorCompoundButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/poll_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="@string/poll_create"
                style="@style/UiKit.Material.Button" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
