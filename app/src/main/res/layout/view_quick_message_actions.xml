<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/drawable_quick_message_actions_bg" android:elevation="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <ImageButton android:id="@+id/quick_message_reply" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reply_24dp" android:contentDescription="@string/message_action_reply" app:tint="?attr/colorInteractiveNormal"/>
    <ImageButton android:id="@+id/quick_message_edit" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit_24dp" android:contentDescription="@string/edit" app:tint="?attr/colorInteractiveNormal"/>
    <ImageButton android:id="@+id/quick_message_delete" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_delete_24dp" android:contentDescription="@string/delete" app:tint="?attr/colorInteractiveNormal"/>
