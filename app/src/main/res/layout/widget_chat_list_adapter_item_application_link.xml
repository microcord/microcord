<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/application_link_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/uikit_guideline_chat"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorBackgroundSecondaryAlt"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        style="@style/UiKit.Chat.Embed.CardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.discord.views.VitoImageView
                android:id="@+id/application_link_banner"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <com.discord.views.VitoImageView
                    android:id="@+id/application_link_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    app:placeholderImage="?attr/ic_game_icon_placeholder"
                    app:roundedCornerRadius="12dp" />

                <TextView
                    android:id="@+id/application_link_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    style="@style/UiKit.TextView.Semibold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View android:id="@+id/chat_list_adapter_item_highlighted_bg" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <View android:id="@+id/chat_list_adapter_item_gutter_bg" android:background="?attr/color_brand" android:visibility="gone" android:layout_width="2dp" android:layout_height="match_parent" android:layout_gravity="start"/>
</FrameLayout>
