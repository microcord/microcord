<?xml version="1.0" encoding="utf-8"?>
<!-- The modern message menu: same ids as widget_chat_list_actions (the legacy menu), so one view binding serves both. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="?attr/colorBackgroundPrimary" android:overScrollMode="never" style="@style/UiKit.ViewGroup.NestedScrollView">
    <LinearLayout android:id="@+id/dialog_chat_actions_container" android:visibility="gone" android:paddingBottom="24dp" style="@style/UiKit.ViewGroup.LinearLayout">
        <androidx.recyclerview.widget.RecyclerView android:layout_gravity="center" android:id="@+id/dialog_chat_actions_add_reaction_emojis_list" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/add_reaction" android:nestedScrollingEnabled="false" style="@style/UiKit.ViewGroup.RecyclerView.Horizontal"/>
        <com.discord.widgets.chat.list.actions.MessageMenuGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/dialog_chat_actions_resend" android:text="@string/resend_message" app:drawableStartCompat="@drawable/ic_menu_resend" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_edit" android:text="@string/edit" app:drawableStartCompat="@drawable/ic_menu_edit" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_end_poll" android:visibility="gone" android:text="@string/poll_end_now" app:drawableStartCompat="@drawable/ic_menu_end_poll" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_reply" android:text="@string/message_action_reply" app:drawableStartCompat="@drawable/ic_menu_reply" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_share" android:visibility="gone" android:text="@string/forward_message" app:drawableStartCompat="@drawable/ic_menu_forward" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_start_thread" android:visibility="gone" android:text="@string/create_thread" app:drawableStartCompat="@drawable/ic_menu_thread" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
        </com.discord.widgets.chat.list.actions.MessageMenuGroup>
        <com.discord.widgets.chat.list.actions.MessageMenuGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/dialog_chat_actions_publish" android:visibility="gone" android:text="@string/news_channel_publish" app:drawableStartCompat="@drawable/ic_menu_publish" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_copy_media" android:visibility="gone" android:text="@string/copy_media_link" app:drawableStartCompat="@drawable/ic_menu_link" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_save_media" android:visibility="gone" android:text="@string/download" app:drawableStartCompat="@drawable/ic_menu_download" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_copy" android:text="@string/copy_text" app:drawableStartCompat="@drawable/ic_menu_copy" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_copy_link" android:text="@string/copy_message_link" app:drawableStartCompat="@drawable/ic_menu_link" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_mark_unread" android:text="@string/mark_unread" app:drawableStartCompat="@drawable/ic_menu_mark_unread" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_pin" android:text="@string/pin" app:drawableStartCompat="@drawable/ic_menu_pin" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_bookmark" android:text="@string/bookmark_action_add" app:drawableStartCompat="@drawable/ic_bookmark_24dp" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_interaction_info" android:visibility="gone" android:text="@string/view_interaction_info" app:drawableStartCompat="@drawable/ic_menu_info" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_profile" android:text="@string/profile" app:drawableStartCompat="@drawable/ic_menu_profile" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_manage_reactions" android:text="@string/reactions" app:drawableStartCompat="@drawable/ic_menu_view_reactions" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_apps" android:visibility="gone" android:text="@string/apps" app:drawableStartCompat="@drawable/ic_menu_apps" app:drawableEndCompat="@drawable/ic_menu_chevron" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <LinearLayout android:id="@+id/plugin_context_menu_items" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.discord.widgets.chat.list.actions.MessageMenuGroup>
        <com.discord.widgets.chat.list.actions.MessageMenuGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/dialog_chat_actions_remove_all_reactions" android:text="@string/remove_all_reactions" app:drawableStartCompat="@drawable/ic_menu_remove_reactions" app:drawableTint="@color/status_red" style="@style/MessageMenu.Row.Danger"/>
            <TextView android:id="@+id/dialog_chat_actions_remove_embeds" android:visibility="gone" android:text="@string/suppress_all_embeds" app:drawableStartCompat="@drawable/ic_menu_remove_embeds" app:drawableTint="@color/status_red" style="@style/MessageMenu.Row.Danger"/>
            <TextView android:id="@+id/dialog_chat_actions_report" android:visibility="gone" android:text="@string/report" app:drawableStartCompat="@drawable/ic_menu_report" app:drawableTint="@color/status_red" style="@style/MessageMenu.Row.Danger"/>
            <TextView android:id="@+id/dialog_chat_actions_delete" android:text="@string/delete" app:drawableStartCompat="@drawable/ic_menu_delete" app:drawableTint="@color/status_red" style="@style/MessageMenu.Row.Danger"/>
            <TextView android:id="@+id/dialog_chat_actions_copy_id" android:visibility="gone" android:text="@string/copy_id" app:drawableStartCompat="@drawable/ic_menu_id" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_copy_raw" android:visibility="gone" android:text="@string/view_raw_copy_raw" app:drawableStartCompat="@drawable/ic_menu_copy" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_view_raw" android:visibility="gone" android:text="@string/developer_view_raw" app:drawableStartCompat="@drawable/ic_view_raw_24dp" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
            <TextView android:id="@+id/dialog_chat_actions_install_theme" android:visibility="gone" android:text="@string/microcord_themes_install" app:drawableStartCompat="@drawable/ic_theme_24dp" app:drawableTint="?attr/colorInteractiveNormal" style="@style/MessageMenu.Row"/>
        </com.discord.widgets.chat.list.actions.MessageMenuGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
