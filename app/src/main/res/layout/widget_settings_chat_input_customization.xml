<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UiKit.ViewGroup.Page">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout android:orientation="vertical" app:layout_behavior="@string/appbar_scrolling_view_behavior" style="@style/UiKit.ViewGroup.LinearLayout">
        <TextView android:id="@+id/chat_input_customization_description" android:padding="16dp" android:text="@string/chat_input_customization_description" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView"/>
        <LinearLayout android:id="@+id/chat_input_customization_preview" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingBottom="16dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
            <LinearLayout android:id="@+id/chat_input_customization_left" android:gravity="center_vertical" android:minWidth="48dp" android:layout_width="wrap_content" android:layout_height="56dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal"/>
            <LinearLayout android:id="@+id/chat_input_customization_inside" android:gravity="center_vertical" android:background="@drawable/drawable_flex_input_bg" android:minWidth="96dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal">
                <TextView android:id="@+id/chat_input_customization_hint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/chat_input_customization_hint" android:textColor="?attr/colorTextMuted" style="@style/UiKit.TextView"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/chat_input_customization_right" android:gravity="center_vertical" android:minWidth="48dp" android:layout_width="wrap_content" android:layout_height="56dp" style="@style/UiKit.ViewGroup.LinearLayout.Horizontal"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:orientation="vertical" style="@style/UiKit.ViewGroup.LinearLayout">
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_profile" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_attachment" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_apps" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_expand" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_expression" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_send" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <com.discord.views.CheckedSetting android:id="@+id/chat_input_customization_keyboard" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed"/>
                <TextView android:id="@+id/chat_input_customization_plugins_header" android:visibility="gone" android:text="@string/plugins" style="@style/UiKit.Settings.Item.Header"/>
                <LinearLayout android:id="@+id/chat_input_customization_plugins" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
