<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/app_launcher_scroller_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/UiKit.TextView.H2" />

        <TextView
            android:id="@+id/app_launcher_scroller_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/app_launcher_view_all"
            android:textColor="?attr/colorTextBrand"
            style="@style/UiKit.TextView.Medium" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_launcher_scroller_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
