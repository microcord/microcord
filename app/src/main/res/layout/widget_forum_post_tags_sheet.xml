<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/primary_630"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/post_tags_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/colorHeaderPrimary"
        style="@style/UiKit.TextView.H2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:text="@string/forum_tags_info"
        android:textColor="?attr/colorHeaderSecondary"
        style="@style/UiKit.TextView.Subtext" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="320dp">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/post_tags_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:flexWrap="wrap" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/post_tags_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/save"
        style="@style/UiKit.Material.Button" />
</LinearLayout>
