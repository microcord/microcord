<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/uikit_guideline_chat"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        style="@style/UiKit.Chat.Embed.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorBackgroundSecondary"
        android:orientation="vertical">

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/activity_art"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:contentDescription="@string/activity_message_art"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/activity_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:placeholderImage="?attr/ic_game_icon_placeholder"
                app:roundAsCircle="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textSize="@dimen/uikit_textsize_large"
                    style="@style/UiKit.TextView.H1" />

                <TextView
                    android:id="@+id/activity_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/UiKit.TextView.Subtext" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:id="@+id/activity_avatars"
                android:layout_width="96dp"
                android:layout_height="32dp"
                android:contentDescription="@string/embedded_activity_participants">

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/activity_avatar_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:roundAsCircle="true" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/activity_avatar_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="24dp"
                    app:roundAsCircle="true" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/activity_avatar_3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="48dp"
                    app:roundAsCircle="true" />
            </FrameLayout>

            <com.discord.views.LoadingButton
                android:id="@+id/activity_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:lb_disable_elevation="true"
                app:lb_progress_color="@color/white"
                app:lb_text="@string/embedded_activities_join"
                style="@style/UiKit.Material.Button.Green.Fit" />
        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View android:id="@+id/chat_list_adapter_item_highlighted_bg" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <View android:id="@+id/chat_list_adapter_item_gutter_bg" android:background="?attr/color_brand" android:visibility="gone" android:layout_width="2dp" android:layout_height="match_parent" android:layout_gravity="start"/>
</FrameLayout>
