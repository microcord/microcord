<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Hardware the app can use but never requires: every entry is required="false" so the app
        stays installable on devices without a camera, microphone or bluetooth radio, exactly as
        the reference declares it.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Normal permissions. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!--
      Voice audio routing.

      BLUETOOTH is install-time and was removed in API 31, hence maxSdkVersion. On its own that
      leaves Bluetooth routing dead on every device this build actually targets (targetSdk 36), so
      BLUETOOTH_CONNECT — its runtime replacement — is declared alongside it. `AudioPermissions`
      accepts either, and every Bluetooth call in DiscordAudioManager degrades safely when neither
      is granted. The runtime request itself still needs adding to AppPermissions.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Runtime permissions requested by com.discord.app.AppPermissions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Direct FlexInput MediaStore browsing. System photo/document pickers need no broad access. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- Required from API 33 or NotificationManagerCompat silently drops every notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Special-access permissions: granted from system settings, never from a runtime dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Android 11 package visibility. Without this block the app cannot resolve the Spotify,
        Samsung Game Tools/Home or authenticator apps, nor the chooser/pick/get-content/custom-tab
        intents it launches, on API 30+.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.CHOOSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />

            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />

            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>

        <package android:name="com.spotify.music" />
        <package android:name="com.samsung.android.game.gametools" />
        <package android:name="com.samsung.android.game.gamehome" />
        <package android:name="com.authy.authy" />
        <package android:name="com.google.android.apps.authenticator2" />
    </queries>

    <application
        android:name="com.discord.app.App"
        android:allowBackup="false"
        android:appCategory="social"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/manticord_app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Dark"
        tools:targetApi="n">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/image_share_filepaths" />
        </provider>
        <!--
            The base activity, so AppScreenRouter screen intents can start a real activity instead
            of only ever back-stacking a fragment onto Main. Not exported and filter-less: it is
            reachable only from an explicit in-process intent.
        -->
        <activity
            android:name="com.discord.app.AppActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.Dark"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="com.discord.activities.EmbeddedActivityActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme.Dark" />
        <activity
            android:name="com.discord.app.AppActivity$Main"
            android:exported="true"
            android:label="@string/manticord_app_name"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.Loading"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="discord.com" />
                <data android:host="www.discord.com" />
                <data android:host="ptb.discord.com" />
                <data android:host="canary.discord.com" />
                <data android:host="discordapp.com" />
                <data android:host="www.discordapp.com" />
                <data android:host="ptb.discordapp.com" />
                <data android:host="canary.discordapp.com" />
                <data android:pathPrefix="/app" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/gifts/" />
                <data android:pathPrefix="/template/" />
                <data android:pathPrefix="/channels/" />
                <data android:pathPrefix="/users/" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/feature/" />
                <data android:pathPrefix="/discovery" />
                <data android:pathPrefix="/query/" />
                <data android:pathPrefix="/ra/" />
                <data android:pathPrefix="/events/" />
                <data android:pathPrefix="/connect/authorize" />
                <!-- The only credential recovery the app redeems itself. A plain password reset
                     mails a `/reset#token=` link instead, whose token is in the fragment; the
                     reference hands those to the browser, so we do not claim that path. -->
                <data android:pathPrefix="/login/one-time" />
            </intent-filter>
            <!-- Discord-owned domains cannot verify this app's package and signing certificate. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="discord.gg" />
                <data android:host="discord.gift" />
                <data android:host="discord.new" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="discord" />
                <data android:scheme="manticord" />
                <data android:host="app" />
                <data android:host="action" />
                <data android:pathPrefix="/" />
            </intent-filter>

            <!-- App shortcuts and Direct Share targets (res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name="com.discord.app.AppActivity$Call"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name="com.discord.app.AppActivity$IncomingCall"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <activity
            android:name="com.discord.app.AppActionActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@style/AppTheme.Loading"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.discord.intent.action.SDK" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="discord" />
                <data android:scheme="manticord" />
                <data android:host="sdk" />
                <data android:pathPrefix="/" />
            </intent-filter>
        </activity>

        <!--
            Avatar/banner cropping. com.discord.media_picker.MediaPicker already launches UCrop, and
            the ucrop 2.2.6 AAR ships an activity-less manifest, so without this entry every crop
            throws ActivityNotFoundException. Not exported: only this app starts it.
        -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!--
            Notification action broadcasts (mark-as-read, direct reply, delete, cancel). Not
            exported: every PendingIntent that targets it names the component explicitly, so no
            other app needs to reach it, and the intent-filter exists only to document the contract.
        -->
        <receiver
            android:name="com.discord.utilities.notifications.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.mantikafasi.manticord.notification.MARK_READ" />
                <action android:name="dev.mantikafasi.manticord.notification.REPLY" />
                <action android:name="dev.mantikafasi.manticord.notification.DELETE" />
                <action android:name="dev.mantikafasi.manticord.notification.CANCEL" />
            </intent-filter>
        </receiver>

        <!--
            DownloadManager broadcasts completion from another UID, so this receiver has to be
            exported. It reads only EXTRA_DOWNLOAD_ID from the intent and re-queries DownloadManager
            for the actual status, and it drops any id it did not enqueue, so a spoofed broadcast
            can at worst resolve a download we already started.
        -->
        <receiver
            android:name="com.discord.utilities.io.UserDownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.discord.utilities.voice.DiscordOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays user-enabled voice call controls over other apps" />
        </service>
        <service
            android:name="com.discord.utilities.voice.VoiceEngineForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|mediaProjection|microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains an ongoing receive-only voice or stage connection" />
        </service>
        <service
            android:name="com.discord.app.DiscordConnectService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Connects an app-owned voice deep link while awaiting the gateway" />
        </service>

        <!-- Google Assistant App Actions fulfillment (res/xml/actions.xml). -->
        <meta-data
            android:name="com.google.android.actions"
            android:resource="@xml/actions" />
    </application>

</manifest>
